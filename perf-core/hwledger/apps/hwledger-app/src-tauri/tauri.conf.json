{
  "$schema": "https://raw.githubusercontent.com/nicokosi/tauri-v2/main/crates/tauri-utils/schema.json",
  "productName": "hwLedger",
  "version": "0.1.0",
  "identifier": "com.phenotype.hwledger",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "hwLedger",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ]
  },
  "plugins": {
    "opener": {}
  }
}
